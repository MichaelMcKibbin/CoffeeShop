<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoffeeShop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CoffeeShop.Pages">

    <!-- Login as the initial page, then categories as a named route -->
    <ShellContent Route="login" Title="Login" ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- This makes "//categories" work -->
    <TabBar>
        <ShellContent Route="categories" Title="Menu" ContentTemplate="{DataTemplate pages:CategoriesPage}" />
    </TabBar>
</Shell>
