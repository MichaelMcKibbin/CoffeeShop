###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# C# and .NET files
###############################################################################
*.cs     text diff=csharp eol=crlf
*.xaml   text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.config text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.json   text eol=crlf
*.xml    text eol=crlf
*.md     text eol=crlf

