<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <VerticalStackLayout Padding="16" Spacing="10">
        <VerticalStackLayout.MaximumWidthRequest>
            <OnPlatform x:TypeArguments="x:Double">
                <On Platform="Android" Value="10000" />
                <On Platform="iOS" Value="700" />
                <On Platform="WinUI" Value="700" />
            </OnPlatform>
        </VerticalStackLayout.MaximumWidthRequest>
        <VerticalStackLayout.HorizontalOptions>
            <OnPlatform x:TypeArguments="LayoutOptions">
                <On Platform="Android" Value="Fill" />
                <On Platform="iOS" Value="Center" />
                <On Platform="WinUI" Value="Center" />
            </OnPlatform>
        </VerticalStackLayout.HorizontalOptions>
        <Button Text="Refresh" Command="{Binding LoadCommand}" />

        <CollectionView ItemsSource="{Binding Orders}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding FormattedOrderDate}" 
                                   FontSize="12" 
                                   TextColor="Gray" />
                            <Label Text="{Binding CustomerName}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" />
                            <Label Text="{Binding Summary}" 
                                   LineBreakMode="TailTruncation" 
                                   MaxLines="5" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
