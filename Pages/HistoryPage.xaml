<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Button Text="Refresh" Command="{Binding LoadCommand}" />

        <CollectionView ItemsSource="{Binding Orders}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CustomerName}" FontAttributes="Bold"/>
                            <Label Text="{Binding Summary}" LineBreakMode="TailTruncation" MaxLines="5"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
