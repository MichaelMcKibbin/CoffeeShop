<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Coffee Shop">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="☕ Coffee Shop ☕" FontSize="32" HorizontalOptions="Center" Margin="0,0,0,20"/>
            
            <Label Text="{Binding IsRegistering, Converter={StaticResource BoolToTextConverter}}" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Username" 
                   Text="{Binding Username}"
                   ReturnType="Next" />

            <Entry Placeholder="Password" 
                   Text="{Binding Password}"
                   IsPassword="True"
                   ReturnType="Next" />

            <Entry Placeholder="Full Name" 
                   Text="{Binding FullName}"
                   IsVisible="{Binding IsRegistering}"
                   ReturnType="Next" />

            <Entry Placeholder="Phone Number" 
                   Text="{Binding PhoneNumber}"
                   IsVisible="{Binding IsRegistering}"
                   Keyboard="Telephone"
                   ReturnType="Done" />

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToButtonTextConverter}}"
                    Command="{Binding SubmitCommand}" />

            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToToggleTextConverter}}"
                    Command="{Binding ToggleModeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
