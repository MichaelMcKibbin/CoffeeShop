<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Coffee Shop">

    <Grid>
        <!-- Background Image with theme-aware opacity -->
        <Image Source="coffeeshopbackground.png"
               Aspect="AspectFill"
               Opacity="{AppThemeBinding Light=0.4, Dark=0.2}" />
        
        <!-- Content -->
        <ScrollView>
            <VerticalStackLayout Padding="40,40,40,40" Spacing="16">
                <VerticalStackLayout.MaximumWidthRequest>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="Android" Value="10000" />
                        <On Platform="iOS" Value="600" />
                        <On Platform="WinUI" Value="600" />
                    </OnPlatform>
                </VerticalStackLayout.MaximumWidthRequest>
                <VerticalStackLayout.HorizontalOptions>
                    <OnPlatform x:TypeArguments="LayoutOptions">
                        <On Platform="Android" Value="Fill" />
                        <On Platform="iOS" Value="Center" />
                        <On Platform="WinUI" Value="Center" />
                    </OnPlatform>
                </VerticalStackLayout.HorizontalOptions>
            <Border BackgroundColor="Beige"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    Margin="0,20,0,20"
                    Padding="16,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="☕ Coffee Shop ☕" 
                           FontSize="28" 
                           HorizontalOptions="Center" />
                    <Label Text="It's not just Java anymore!" 
                           FontSize="14" 
                           FontAttributes="Italic"
                           HorizontalOptions="Center"
                           Opacity="0.8" />
                </VerticalStackLayout>
            </Border>
            
            <Label Text="{Binding IsRegistering, Converter={StaticResource BoolToTextConverter}}" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Username" 
                   Text="{Binding Username}"
                   ReturnType="Next" />

            <Entry Placeholder="Password" 
                   Text="{Binding Password}"
                   IsPassword="True"
                   ReturnType="Next" />

            <Entry Placeholder="Full Name" 
                   Text="{Binding FullName}"
                   IsVisible="{Binding IsRegistering}"
                   ReturnType="Next" />

            <Entry Placeholder="Phone Number" 
                   Text="{Binding PhoneNumber}"
                   IsVisible="{Binding IsRegistering}"
                   Keyboard="Telephone"
                   ReturnType="Done" />

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToButtonTextConverter}}"
                    Command="{Binding SubmitCommand}" />

            <!-- Toggle between Login/Register modes - styled as secondary button -->
            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToToggleTextConverter}}"
                    Command="{Binding ToggleModeCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                    BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                    BorderWidth="2"
                    LineBreakMode="WordWrap"
                    HeightRequest="60"
                    Padding="8,0"
                    Margin="0,8,0,0" />
            
            <!-- Guest Mode Button -->
            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,20,0,10"/>
            
            <Button Text="Continue as Guest"
                    Command="{Binding ContinueAsGuestCommand}"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource DarkOnLightBackground}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
