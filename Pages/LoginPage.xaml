<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Coffee Shop">

    <Grid>
        <!-- Background Image -->
        <Image Source="coffeeshopbackground.png"
               Aspect="AspectFill"
               Opacity="0.5" />
        
        <!-- Content -->
        <ScrollView>
            <VerticalStackLayout Padding="40,40,40,40" Spacing="16">
            <Border BackgroundColor="Beige"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    Margin="0,20,0,20"
                    Padding="16,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="☕ Coffee Shop ☕" 
                           FontSize="32" 
                           HorizontalOptions="Center" />
                    <Label Text="It's not just Java anymore!" 
                           FontSize="14" 
                           FontAttributes="Italic"
                           HorizontalOptions="Center"
                           Opacity="0.8" />
                </VerticalStackLayout>
            </Border>
            
            <Label Text="{Binding IsRegistering, Converter={StaticResource BoolToTextConverter}}" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Username" 
                   Text="{Binding Username}"
                   ReturnType="Next" />

            <Entry Placeholder="Password" 
                   Text="{Binding Password}"
                   IsPassword="True"
                   ReturnType="Next" />

            <Entry Placeholder="Full Name" 
                   Text="{Binding FullName}"
                   IsVisible="{Binding IsRegistering}"
                   ReturnType="Next" />

            <Entry Placeholder="Phone Number" 
                   Text="{Binding PhoneNumber}"
                   IsVisible="{Binding IsRegistering}"
                   Keyboard="Telephone"
                   ReturnType="Done" />

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToButtonTextConverter}}"
                    Command="{Binding SubmitCommand}" />

            <Button Text="{Binding IsRegistering, Converter={StaticResource BoolToToggleTextConverter}}"
                    Command="{Binding ToggleModeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
