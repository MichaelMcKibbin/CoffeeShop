<?xml version="1.0" encoding="utf-8" ?>
<!--
    CategoriesPage.xaml
    Main navigation page displayed after user login
    Allows users to browse menu categories, view order history, and logout
-->
<ContentPage
    x:Class="CoffeeShop.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Categories">

    <!-- Root layout: Grid enables layering of background image and content -->
    <Grid>
        <!-- Background Image: Coffee shop themed background with reduced opacity (40%) -->
        <!-- AspectFill ensures the image covers the entire screen without distortion -->
        <Image Source="coffeeshopbackground.png"
               Aspect="AspectFill"
               Opacity="0.40" />
        
        <!-- Content Layer: Main navigation and user interface -->
        <!-- Padding: 60px horizontal for ~80% width responsive design, 60px top, 10px bottom -->
        <!-- Spacing: 12px between buttons for comfortable touch targets -->
        <VerticalStackLayout Padding="60,60,60,10" Spacing="12">
            <VerticalStackLayout.MaximumWidthRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="10000" />
                    <On Platform="iOS" Value="600" />
                    <On Platform="WinUI" Value="600" />
                </OnPlatform>
            </VerticalStackLayout.MaximumWidthRequest>
            <VerticalStackLayout.HorizontalOptions>
                <OnPlatform x:TypeArguments="LayoutOptions">
                    <On Platform="Android" Value="Fill" />
                    <On Platform="iOS" Value="Center" />
                    <On Platform="WinUI" Value="Center" />
                </OnPlatform>
            </VerticalStackLayout.HorizontalOptions>
        
            <!-- Welcome Message: Displays personalized greeting with user's name -->
            <!-- Bound to WelcomeMessage property in CategoriesPageModel -->
            <Label Text="{Binding WelcomeMessage}" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   Margin="0,10,0,20" />

            <!-- Menu Category Navigation: Primary action buttons -->
            <!-- Each button navigates to MenuPage filtered by category -->
            
            <!-- Hot Drinks Category Button -->
            <Button Text="Hot drinks"
                    Command="{Binding OpenCategoryCommand}"
                    CommandParameter="HotDrinks" />

            <!-- Cold Drinks Category Button -->
            <Button Text="Cold drinks"
                    Command="{Binding OpenCategoryCommand}"
                    CommandParameter="ColdDrinks" />

            <!-- Food Category Button -->
            <Button Text="Food"
                    Command="{Binding OpenCategoryCommand}"
                    CommandParameter="Food" />

            <!-- Visual Separator: Divides primary navigation from secondary actions -->
            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,10"/>

            <!-- Secondary Actions: User account and history features -->
            
            <!-- Order History Button: Navigates to HistoryPage to view past orders -->
            <!-- Disabled for guest users (they have no saved history) -->
            <Button Text="Order History"
                    Command="{Binding OpenHistoryCommand}"
                    IsEnabled="{Binding CanViewHistory}"
                    Opacity="{Binding CanViewHistory, Converter={StaticResource BoolToOpacityConverter}}" />
            
            <!-- Settings Button: Navigate to app settings (theme, etc.) -->
            <Button Text="⚙️ Settings"
                    Command="{Binding OpenSettingsCommand}" />
        
            <!-- Logout Button: Clears user session and returns to login -->
            <!-- Uses Gray300 background to visually distinguish from primary actions -->
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource DarkOnLightBackground}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
