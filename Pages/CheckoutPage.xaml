<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeShop.Pages.CheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid.MaximumWidthRequest>
            <OnPlatform x:TypeArguments="x:Double">
                <On Platform="Android" Value="10000" />
                <On Platform="iOS" Value="700" />
                <On Platform="WinUI" Value="700" />
            </OnPlatform>
        </Grid.MaximumWidthRequest>
        <Grid.HorizontalOptions>
            <OnPlatform x:TypeArguments="LayoutOptions">
                <On Platform="Android" Value="Fill" />
                <On Platform="iOS" Value="Center" />
                <On Platform="WinUI" Value="Center" />
            </OnPlatform>
        </Grid.HorizontalOptions>

        <VerticalStackLayout Spacing="4">
            <Label Text="Order for:" FontSize="12" TextColor="Gray" />
            <Label Text="{Binding CustomerName}" FontSize="16" FontAttributes="Bold" />
            <Label Text="{Binding Telephone}" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Lines}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Padding="10">
                        <Label Text="{Binding .}" />
                        <Button Grid.Column="1" Text="Remove"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveLineCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="{Binding Total, StringFormat='Place Order (Total: €{0:0.00})'}"
                Command="{Binding PlaceOrderCommand}"
                BackgroundColor="{StaticResource Tertiary}" />
    </Grid>
</ContentPage>
